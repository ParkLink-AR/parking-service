PORT=3001

# Base de datos: DB_* sueltos, o DATABASE_URL (que tiene prioridad).
DB_HOST=localhost
DB_PORT=5432
DB_USER=parklink
DB_PASSWORD=parklink
DB_NAME=parking_service
# DATABASE_URL=postgresql://parklink:parklink@localhost:5432/parking_service

# Datos de ejemplo al arrancar (solo dev).
SEED_DEV_DATA=true

# Las requests tienen que traer el secret del gateway o la key interna entre
# servicios. Tienen que coincidir con las del gateway y el resto.
GATEWAY_INTERNAL_SECRET=dev-gateway-secret-change-me
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

BOOKING_SERVICE_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8000

# Geocoding de direcciones.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=parklink-app/1.0

# Eventos de dominio al bus compartido. Vacío = no publica.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Cloudflare R2: fotos de cochera (mismo bucket público que auth-service).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Sentry (reportes de errores). DSN vacío = apagado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Cocheras de ejemplo (contenido y fotos) al arrancar. false lo apaga.
SEED_DEMO_DATA=true
